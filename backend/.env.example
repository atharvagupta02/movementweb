# ---- Required ----
PORT=8080
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Long random string. Anyone holding it can mint logins - never commit the real one.
JWT_SECRET=
# The owner's login email. Exactly one account is the admin; it is matched by email.
ADMIN_EMAIL=owner@example.com

# ---- Attendance: where staff may check in from ----
# The clinic's PUBLIC IP (open https://ifconfig.me while on the clinic WiFi), as a
# comma-separated list of IPv4/IPv6 addresses and/or IPv4 CIDR ranges.
# When this is set it is ALWAYS enforced, so 127.0.0.1 alone (a dev value) would
# lock every real employee out. Production example: CLINIC_IPS=203.0.113.47
CLINIC_IPS=
# true = refuse check-in when CLINIC_IPS is empty (recommended in production).
CLINIC_IP_ENFORCE=true
# Number of proxies in front of this server (Render/Railway/nginx = 1, none = leave unset).
# Wrong value either way breaks the clinic IP check: unset behind a proxy makes every
# request look like it came from the proxy; set with no proxy lets clients forge their IP.
# TRUST_PROXY=1

# ---- Attendance: shift rules (IST) ----
SHIFT_START_HOUR=8
SHIFT_START_MINUTE=0
ATTENDANCE_GRACE_MINUTES=15
# Name shown in the authenticator app next to each employee.
TOTP_ISSUER=Movement Rehab
